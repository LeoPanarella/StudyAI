# Copie para .env e ajuste os valores.
ENV=development

# A aplicação depende apenas desta URL. Crie o banco/usuário do seu jeito e aponte aqui.
# Formato: postgresql+psycopg://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
DATABASE_URL=postgresql+psycopg://studyai:troque_esta_senha@localhost:5432/studyai

# Gere com: openssl rand -hex 32
SECRET_KEY=troque_por_um_valor_longo_e_aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Em produção (HTTPS) use true
COOKIE_SECURE=false

# Só necessário se o frontend for servido de outra origem (ex.: https://app.seudominio.com)
CORS_ORIGINS=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# IA (fases 3-5)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro
GEMINI_TIMEOUT_SECONDS=90
GEMINI_RETRY_ROUNDS=8
